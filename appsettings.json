  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:8080" ]
  },
  "Attendance": {
    "EditGraceMinutes": 15
  },
  "Seed": {
    "AdminEmail": "admin@attendance.local",
    "AdminPassword": "Admin@12345"
  }
